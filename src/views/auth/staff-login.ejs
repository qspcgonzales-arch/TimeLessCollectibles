<%- include('../partials/header') %>
<section class="form-shell narrow-panel">
  <p class="eyebrow">Staff access</p>
  <h1>Staff Login</h1>
  <form method="post" action="/auth/staff-login" class="mt-4 d-grid gap-3">
    <input class="form-control" type="email" name="email" placeholder="Staff email" required>
    <input class="form-control" type="password" name="password" placeholder="Staff password" required>
    <button class="btn btn-accent" type="submit">Continue</button>
  </form>
  <div class="d-flex justify-content-between mt-3">
    <a href="/auth/login">Back to customer login</a>
  </div>
</section>
<%- include('../partials/footer') %>
