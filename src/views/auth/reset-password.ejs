<%- include('../partials/header') %>
<section class="form-shell narrow-panel">
  <p class="eyebrow">Secure account recovery</p>
  <h1>Choose a new password</h1>
  <form method="post" action="/auth/reset-password" class="mt-4 d-grid gap-3">
    <input type="hidden" name="token" value="<%= token %>">
    <input class="form-control" type="password" name="password" placeholder="New password" required>
    <input class="form-control" type="password" name="confirmPassword" placeholder="Confirm new password" required>
    <button class="btn btn-accent" type="submit">Update password</button>
  </form>
</section>
<%- include('../partials/footer') %>
