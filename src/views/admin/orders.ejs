<%- include('../partials/header') %>
<section class="table-shell admin-panel admin-table-shell">
  <div class="section-heading mb-3">
    <div>
      <p class="eyebrow">Admin</p>
      <h1>Orders</h1>
      <p class="muted mb-0"><%= orders.length %> total orders</p>
    </div>
  </div>
  <div class="admin-toolbar mb-3" data-admin-orders-toolbar>
    <input class="form-control" type="search" placeholder="Search customer, product, or location" data-admin-orders-search>
    <select class="form-select" data-admin-orders-status>
      <option value="all">Status: All</option>
      <option value="pending">Pending</option>
      <option value="delivering">Delivering</option>
      <option value="delivered">Delivered</option>
    </select>
    <span class="admin-count-pill"><span data-admin-orders-count><%= orders.length %></span> visible</span>
  </div>
  <div class="table-responsive">
    <table class="table align-middle admin-orders-table" data-admin-orders-table>
      <thead>
        <tr>
          <th>Order</th>
          <th>Customer</th>
          <th>Product</th>
          <th>Quantity</th>
          <th>Status</th>
          <th>Update</th>
        </tr>
      </thead>
      <tbody data-admin-orders-body>
        <% orders.forEach((order) => { %>
          <tr data-admin-order-row data-status="<%= String(order.statusLabel).toLowerCase() %>" data-email="<%= String(order.email).toLowerCase() %>" data-product="<%= String(order.prodname).toLowerCase() %>" data-location="<%= String((order.address || '') + ' ' + (order.country || '')).toLowerCase() %>">
            <td>#<%= order.OrderID %></td>
            <td>
              <strong><%= order.email %></strong>
              <div class="muted"><%= order.address %>, <%= order.country %></div>
            </td>
            <td><%= order.prodname %></td>
            <td><%= order.quantity %></td>
            <td><span class="badge-status <%= order.statusLabel.toLowerCase() %>"><%= order.statusLabel %></span></td>
            <td>
              <form method="post" action="/admin/orders/<%= order.OrderID %>/status" class="d-flex gap-2">
                <select class="form-select" name="status">
                  <option value="pending" <%= order.statusLabel === 'Pending' ? 'selected' : '' %>>Pending</option>
                  <option value="delivering" <%= order.statusLabel === 'Delivering' ? 'selected' : '' %>>Delivering</option>
                  <option value="delivered" <%= order.statusLabel === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                </select>
                <button class="btn btn-accent" type="submit">Save</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!orders.length) { %>
          <tr>
            <td colspan="6" class="muted">No orders found yet.</td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</section>
<script src="/static/js/admin-tables.js"></script>
<%- include('../partials/footer') %>
